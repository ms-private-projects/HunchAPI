{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Setup environment (uv sync)",
      "type": "shell",
      "command": "uv sync",
      "problemMatcher": []
    },
    {
      "label": "Test",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python -m pytest -q",
      "problemMatcher": []
    },
    {
      "label": "Lint",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/ruff check api src tests && ${workspaceFolder}/.venv/bin/ruff format --check api src tests",
      "problemMatcher": []
    },
    {
      "label": "Export requirements.txt",
      "type": "shell",
      "command": "uv export --locked --no-dev --no-hashes --format requirements-txt -o requirements.txt",
      "problemMatcher": []
    }
  ]
}
